//@version=5
// ================================================================
// KLSE Ex-Dividend Alert — v1
// Exchange : Bursa Malaysia (KLSE)
// Timeframe: Daily (required)
//
// Purpose: Alert you BEFORE the ex-dividend date so you can buy
//          in time to capture the quarterly or semi-annual dividend.
//
//          Reads TradingView's dividend database to find past ex-dates,
//          estimates the next ex-date from the historical pattern,
//          then fires when you enter the configurable buy window.
//
// IMPORTANT: TradingView dividend data coverage varies by stock.
//            Check the "TV Data Coverage" row in the dashboard.
//            If it shows "No data", verify ex-dates manually at:
//            www.bursamalaysia.com  |  i3investor.com  |  klsescreener.com
//
// Signal sequence:
//   Purple diamond   → past ex-date marker (reference)
//   Yellow glow      → buy window open, gates not yet passing
//   Green glow       → buy window open + all quality gates pass — act now
//   Green "BUY-DIV"  → first bar of buy window with gates passing
//   Blue "EX-DATE"   → today is the actual ex-date (last chance to buy)
// ================================================================
indicator("KLSE Ex-Dividend Alert v1", shorttitle="ExDiv v1", overlay=true, max_labels_count=100)

// ================================================================
// INPUTS
// ================================================================
g1 = "Ex-Dividend Settings"
alert_days = input.int(10,   "Alert Window (trading days before ex-date)", minval=3, maxval=30, group=g1,
  tooltip="BUY-DIV alert fires this many trading days before the estimated ex-date. 10 days = 2 calendar weeks.")
min_yield  = input.float(2.0, "Minimum Dividend Yield (%)", minval=0.5, maxval=15.0, step=0.5, group=g1,
  tooltip="Only alert when the estimated annual yield meets this threshold. Filters out token dividends.")
use_gross  = input.bool(true, "Use Gross Dividend (vs Net)", group=g1,
  tooltip="Gross = before withholding tax. KLSE dividends are typically quoted gross.")

g2 = "Quality Filter"
use_tech_filter = input.bool(true,    "Require Bullish Technical Setup", group=g2,
  tooltip="Only alert when price is above EMA 50 and RSI < 75. Avoids buying falling stocks just for yield.")
min_price  = input.float(0.50, "Min Price (RM)",           group=g2)
min_vol    = input.int(200000, "Min Avg Volume (shares)",  group=g2)

g3 = "Display"
show_dash      = input.bool(true, "Show Dashboard",               group=g3)
show_past_divs = input.bool(true, "Mark Past Ex-Dates on Chart",  group=g3)
show_ema       = input.bool(true, "Show EMA 50 and EMA 200",      group=g3)

// ================================================================
// DIVIDEND DATA — TradingView database
// ================================================================
div_field = use_gross ? dividends.gross : dividends.net
div_raw   = request.dividends(syminfo.tickerid, div_field, gaps=barmerge.gaps_on)

// Track the last two ex-date bars to estimate payment interval
var int   bar_at_div1 = na    // most recent ex-date (bar index)
var int   bar_at_div2 = na    // second most recent
var float last_div_amt = na   // most recent dividend per share (RM)

if not na(div_raw)
    bar_at_div2 := bar_at_div1
    bar_at_div1 := bar_index
    last_div_amt := div_raw

// Interval between the two most recent ex-dates (trading days)
div_interval = not na(bar_at_div1) and not na(bar_at_div2) ? bar_at_div1 - bar_at_div2 : na

// Estimated next ex-date bar
est_next_bar = not na(bar_at_div1) and not na(div_interval) ? bar_at_div1 + div_interval : na

// Trading days remaining to estimated next ex-date (positive = upcoming, <=0 = overdue)
days_to_next = not na(est_next_bar) ? est_next_bar - bar_index : na

// Confirmed ex-date today (TradingView data present on this bar)
ex_date_today = not na(div_raw)

// Inside the buy window?
in_buy_window = not na(days_to_next) and days_to_next > 0 and days_to_next <= alert_days

// Edge-triggered: first bar of the buy window
new_in_window = in_buy_window and not in_buy_window[1]

// ================================================================
// DIVIDEND YIELD CALCULATION
// ================================================================
// Estimate annual payment frequency from the observed interval
// ~63 bars apart = quarterly (4x), ~126 = semi-annual (2x), ~252 = annual (1x)
payments_per_year = not na(div_interval) ? math.max(1, math.round(252.0 / div_interval)) : 4
annual_div = not na(last_div_amt) ? last_div_amt * payments_per_year : na
div_yield  = not na(annual_div) and close > 0 ? (annual_div / close) * 100 : na
yield_ok   = not na(div_yield) and div_yield >= min_yield

// ================================================================
// LIQUIDITY & TECHNICAL GATES
// ================================================================
avgVol      = ta.sma(volume, 20)
liquidityOk = close >= min_price and avgVol >= min_vol

ema50      = ta.ema(close, 50)
ema200     = ta.ema(close, 200)
rsi        = ta.rsi(close, 14)
bull_trend = close > ema50
not_ob     = rsi < 75
tech_ok    = use_tech_filter ? (bull_trend and not_ob) : true

all_gates  = liquidityOk and yield_ok and tech_ok

// ================================================================
// SIGNALS
// ================================================================
// BUY-DIV: fires once on the first bar of the buy window when all gates pass
buy_signal = new_in_window and all_gates

// ================================================================
// VISUALS
// ================================================================

// Past ex-date markers — purple diamond below bar
plotshape(show_past_divs and ex_date_today, title="Past Ex-Date", style=shape.diamond,
  location=location.belowbar, color=color.new(#7B1FA2, 0), size=size.small)

// Buy window background
bgcolor(in_buy_window and all_gates     ? color.new(#00E676, 92) : na, title="Buy Window BG — Gates Pass")
bgcolor(in_buy_window and not all_gates ? color.new(#FFD740, 95) : na, title="Buy Window BG — Gates Fail")

// BUY-DIV entry label
plotshape(buy_signal, title="BUY-DIV Signal",
  style=shape.labelup, location=location.belowbar,
  color=color.new(#00E676, 0), text="BUY-DIV", textcolor=color.black, size=size.normal)

// Ex-date today label (actual confirmed ex-date)
plotshape(ex_date_today, title="Ex-Date Today",
  style=shape.labelup, location=location.abovebar,
  color=color.new(#2196F3, 0), text="EX-DATE", textcolor=color.white, size=size.small)

// EMA reference lines
plot(show_ema ? ema50  : na, title="EMA 50",  color=color.new(#FF9800, 30), linewidth=1)
plot(show_ema ? ema200 : na, title="EMA 200", color=color.new(#FF5252, 30), linewidth=2)

// ================================================================
// DASHBOARD
// ================================================================
c_good  = color.new(#00E676, 0)
c_bad   = color.new(#FF5252, 0)
c_warn  = color.new(#FFD740, 0)
c_gray  = color.new(#8B949E, 0)
c_blue  = color.new(#58A6FF, 0)
c_purp  = color.new(#CE93D8, 0)
c_hdr   = color.new(#1F2937, 0)
c_bg    = color.new(#0D1117, 0)
c_dark  = color.new(#161B22, 0)
c_white = color.new(#FFFFFF, 0)

var table dash = table.new(position.top_right, 2, 10,
  bgcolor=c_bg, border_color=color.new(#30363D, 0), border_width=1,
  frame_color=c_blue, frame_width=2)

if show_dash and (barstate.islast or barstate.isrealtime)
    // Header
    table.cell(dash, 0, 0, "KLSE EX-DIV ALERT v1", bgcolor=c_hdr, text_color=c_blue,  text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 0, "Status",                bgcolor=c_hdr, text_color=c_blue,  text_size=size.small)

    // Last dividend
    div_str = not na(last_div_amt) ? "RM " + str.tostring(last_div_amt, "#.####") + " / share" : "No data yet"
    table.cell(dash, 0, 1, "Last Dividend",  bgcolor=c_dark, text_color=c_gray,  text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, div_str,          bgcolor=c_dark, text_color=c_white, text_size=size.small)

    // Payment frequency
    freq_str = not na(div_interval) ? str.tostring(payments_per_year) + "x/yr (every " + str.tostring(div_interval) + " days)" : "Need >= 2 records"
    freq_col = not na(div_interval) ? c_white : c_warn
    table.cell(dash, 0, 2, "Pay Frequency",  bgcolor=c_dark, text_color=c_gray,  text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, freq_str,         bgcolor=c_dark, text_color=freq_col, text_size=size.small)

    // Annual yield
    yield_str = not na(div_yield) ? str.tostring(math.round(div_yield, 2)) + "%" : "--"
    yield_col = not na(div_yield) ? (div_yield >= min_yield ? c_good : c_bad) : c_gray
    table.cell(dash, 0, 3, "Est. Annual Yield",  bgcolor=c_dark, text_color=c_gray,   text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, yield_str,            bgcolor=c_dark, text_color=yield_col, text_size=size.small)

    // Days to next ex-date
    days_str = not na(days_to_next) ? (days_to_next > 0 ? str.tostring(math.round(days_to_next)) + " days away" : days_to_next == 0 ? "TODAY" : "OVERDUE") : "Estimating..."
    days_col = in_buy_window ? c_warn : (not na(days_to_next) and days_to_next <= 0 ? c_purp : c_gray)
    table.cell(dash, 0, 4, "Est. Next Ex-Date",  bgcolor=c_dark, text_color=c_gray,  text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4, days_str,             bgcolor=c_dark, text_color=days_col, text_size=size.small)

    // Technical filter
    tech_fail_why = not bull_trend ? "Below EMA 50" : not not_ob ? "RSI overbought" : ""
    tech_str = use_tech_filter ? (tech_ok ? "PASS" : "FAIL — " + tech_fail_why) : "Disabled"
    tech_col = use_tech_filter ? (tech_ok ? c_good : c_bad) : c_gray
    table.cell(dash, 0, 5, "Tech Filter",  bgcolor=c_dark, text_color=c_gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5, tech_str,       bgcolor=c_dark, text_color=tech_col, text_size=size.small)

    // Liquidity
    liq_fail = close < min_price ? "Price < RM" + str.tostring(min_price) : "Vol too low"
    liq_str  = liquidityOk ? "PASS" : "FAIL — " + liq_fail
    table.cell(dash, 0, 6, "Liquidity Gate",  bgcolor=c_dark, text_color=c_gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 6, liq_str,           bgcolor=c_dark, text_color=liquidityOk ? c_good : c_bad, text_size=size.small)

    // Data coverage
    no_data  = na(bar_at_div1)
    data_str = no_data ? "No data — check Bursa" : not na(bar_at_div2) ? "Good (2+ records)" : "Limited (1 record)"
    data_col = no_data ? c_bad : not na(bar_at_div2) ? c_good : c_warn
    table.cell(dash, 0, 7, "TV Data Coverage",  bgcolor=c_dark, text_color=c_gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 7, data_str,            bgcolor=c_dark, text_color=data_col, text_size=size.small)

    // Overall signal row
    sig_str = buy_signal ? "► BUY WINDOW OPEN" :
              in_buy_window and not all_gates ? "WINDOW — GATES FAIL" :
              ex_date_today ? "EX-DATE TODAY" :
              not na(days_to_next) and days_to_next > 0 ? "WAIT  " + str.tostring(math.round(days_to_next)) + " days" :
              "MONITORING"
    sig_col = buy_signal ? c_good : in_buy_window ? c_warn : ex_date_today ? c_blue : c_gray
    table.cell(dash, 0, 8, "SIGNAL",  bgcolor=c_bg, text_color=c_gray,  text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 8, sig_str,   bgcolor=c_bg, text_color=sig_col, text_size=size.small)

    // Disclaimer
    table.cell(dash, 0, 9, "Next date ESTIMATED from history", bgcolor=c_bg, text_color=color.new(#8B949E, 50), text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 9, "Verify at bursamalaysia.com",      bgcolor=c_bg, text_color=color.new(#8B949E, 50), text_size=size.tiny)

// ================================================================
// ALERTS
// ================================================================
alertcondition(buy_signal,
  title="Ex-Div Buy Window Opens",
  message="ExDiv | {{ticker}} | BUY WINDOW OPEN — estimated ex-date approaching. Check dashboard for yield and days remaining. Price: {{close}}")

alertcondition(ex_date_today,
  title="Ex-Dividend Date Today",
  message="ExDiv | {{ticker}} | EX-DATE IS TODAY. Buy BEFORE market open to capture dividend. Price: {{close}}")

// ================================================================
// END OF SCRIPT
// ================================================================
