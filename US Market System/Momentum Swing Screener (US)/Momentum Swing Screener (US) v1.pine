plot(score,                title="Score 0-13",   display=display.none)
plot(rsi,                  title="RSI Value",     display=display.none)
plot(adx_val,              title="ADX Value",     display=display.none)
plot(mcdx,                 title="MCDX Value",    display=display.none)
plot(new_t1     ? 1 : 0,  title="Tier1 Signal",  display=display.none)
plot(new_t2     ? 1 : 0,  title="Tier2 Signal",  display=display.none)
plot(new_coil   ? 1 : 0,  title="Coil Signal",   display=display.none)
plot(vol_surge  ? 1 : 0,  title="Vol Surge",     display=display.none)
plot(dailyTrend ? 1 : 0,  title="Daily Trend",   display=display.none)
plot(strongRS   ? 1 : 0,  title="RS vs SPY",     display=display.none)
plot(liquidityOk ? 1 : 0, title="Liquidity OK",  display=display.none)
plot(isHammer   ? 1 : 0,  title="Hammer Candle", display=display.none)

